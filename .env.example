# --- Geral
# URL pública (ligações nos emails, SSO, regresso do Stripe). Ex.: https://app.rizoma.pt
CMDB_PUBLIC_URL=http://localhost:3000
# 1 quando servido por HTTPS (cookie "Secure")
CMDB_SECURE_COOKIE=0
# Chave para encriptar segredos na BD (conectores, 2FA). Gere com: openssl rand -hex 32
# Se vazia, é criada automaticamente em /data/secret.key — faça backup desse ficheiro com a BD.
CMDB_SECRET_KEY=
# Password inicial do admin (só no primeiro arranque; se vazia usa "admin123")
CMDB_ADMIN_PASSWORD=

# --- Segurança
# 1 = obriga todos os utilizadores com login por password a configurar 2FA
CMDB_REQUIRE_2FA=0
CMDB_TOTP_ISSUER=Rizoma

# --- SSO (OpenID Connect) — deixe CMDB_OIDC_ISSUER vazio para desativar
# Microsoft Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
CMDB_OIDC_ISSUER=
CMDB_OIDC_CLIENT_ID=
CMDB_OIDC_CLIENT_SECRET=
CMDB_OIDC_LABEL=Microsoft
# Por omissão: ${CMDB_PUBLIC_URL}/api/auth/oidc/callback
CMDB_OIDC_REDIRECT_URI=

# --- Conectores Microsoft 365 / Azure
# Intervalo (horas) entre sincronizações automáticas
CMDB_SYNC_HOURS=24

# --- Cópias de segurança automáticas (BD + chave de encriptação)
# Intervalo em horas (0 = desativar); por omissão 24
CMDB_BACKUP_HOURS=24
# Número de cópias a manter
CMDB_BACKUP_KEEP=14
# Pasta das cópias (por omissão: <pasta da BD>/backups). Copie-as também para fora do servidor.
CMDB_BACKUP_DIR=
# Comando que envia cada cópia para fora do servidor (o caminho vem em $BACKUP_FILE). Ver docs/operacao.md
# Ex.: rclone copy "$BACKUP_FILE" remoto:rizoma-backups/
CMDB_BACKUP_UPLOAD_CMD=

# --- Email (resumo semanal de garantias, contratos e agentes) — deixe CMDB_SMTP_HOST vazio para desativar
CMDB_SMTP_HOST=
# 587 = STARTTLS (por omissão); 465 = TLS direto
CMDB_SMTP_PORT=587
CMDB_SMTP_USER=
CMDB_SMTP_PASS=
CMDB_SMTP_FROM=Rizoma <rizoma@empresa.pt>
# 1 = aceitar certificados não confiáveis (apenas servidores SMTP internos)
CMDB_SMTP_INSECURE=0
# Dia do resumo: 0 = domingo … 1 = segunda (omissão) … 6 = sábado; "off" desativa o envio automático
CMDB_DIGEST_WEEKDAY=1
# Hora a partir da qual é enviado (hora local do servidor)
CMDB_DIGEST_HOUR=8

# --- Registo de eventos
# text (omissão) ou json (uma linha JSON por evento, para Loki/Elastic/Datadog)
CMDB_LOG_FORMAT=text
# debug | info | warn | error ("debug" regista todos os pedidos à API)
CMDB_LOG_LEVEL=info

# --- Proxy HTTPS (docker-compose, serviço caddy)
CMDB_DOMAIN=cmdb.empresa.pt

# --- SaaS (organizações)
# 1 = registo self-service de novas organizações no ecrã de login
CMDB_SIGNUP=0
# Limites por omissão das organizações novas (vazio = sem limite)
CMDB_PLAN_MAX_CLIENTS=
CMDB_PLAN_MAX_CIS=
CMDB_PLAN_MAX_USERS=
# Retenção da auditoria em dias (0 = guardar tudo)
CMDB_AUDIT_RETENTION_DAYS=730

# --- Subscrições (Stripe). Sem chave, os pagamentos ficam desligados e as organizações não têm período experimental.
# Ver docs/faturacao.md
CMDB_STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook ${CMDB_PUBLIC_URL}/api/stripe/webhook (whsec_…)
CMDB_STRIPE_WEBHOOK_SECRET=
# Plano → price id do Stripe, em JSON. Planos: essencial, profissional, empresa (ver src/plans.js)
CMDB_STRIPE_PRICES={"essencial":"price_...","profissional":"price_..."}
# Dias de período experimental das organizações registadas
CMDB_TRIAL_DAYS=14

# --- Vulnerabilidades (NVD). Opcional: com chave, a atualização é ~10x mais rápida.
# Pedir em https://nvd.nist.gov/developers/request-an-api-key
CMDB_NVD_API_KEY=

# --- Operação
# Token para GET /api/metrics (Prometheus, "Authorization: Bearer <token>"). Vazio = sem métricas
CMDB_METRICS_TOKEN=
# Documentos legais (com CMDB_TERMS_URL, o registo exige a aceitação). Ver docs/legal/
CMDB_TERMS_URL=
CMDB_PRIVACY_URL=
CMDB_TERMS_VERSION=
